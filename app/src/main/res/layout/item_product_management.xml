<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.ProductPrice.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="3dp"
    android:layout_marginTop="3dp"
    android:layout_marginEnd="3dp"
    android:layout_marginBottom="3dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="13dp"
    app:cardElevation="0dp"
    app:strokeColor="#E1E5E2"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="9dp"
        android:paddingTop="8dp"
        android:paddingEnd="7dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="30dp"
                android:layout_height="30dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_category_icon" />

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:contentDescription="Product"
                    android:src="@drawable/ic_product"
                    app:tint="#107C10" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_product_name_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Product Name"
                    android:textColor="#242424"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_product_category_item"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Category"
                        android:textColor="#616161"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/text_product_status_item"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_active"
                        android:paddingStart="6dp"
                        android:paddingTop="1dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="1dp"
                        android:text="Active"
                        android:textColor="#107C10"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_edit_product"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Edit product"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:padding="7dp"
                app:icon="@drawable/ic_edit"
                app:iconSize="16dp"
                app:iconTint="#0F6CBD" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_delete_product"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Delete product"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:padding="7dp"
                app:icon="@drawable/ic_delete"
                app:iconSize="16dp"
                app:iconTint="#C42B1C" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#EFFAF3"
                app:cardCornerRadius="9dp"
                app:cardElevation="0dp"
                app:strokeColor="#B6DEBF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VP" android:textColor="#52715A" android:textSize="8sp" />
                    <TextView android:id="@+id/text_product_vp_item" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00 VP" android:textColor="#107C10" android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#EFFAF3"
                app:cardCornerRadius="9dp"
                app:cardElevation="0dp"
                app:strokeColor="#B6DEBF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FULL" android:textColor="#52715A" android:textSize="8sp" />
                    <TextView android:id="@+id/text_product_full_item" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹0" android:textColor="#107C10" android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="40dp" android:layout_marginEnd="2dp" android:layout_weight="1" app:cardBackgroundColor="#EEF6FD" app:cardCornerRadius="8dp" app:cardElevation="0dp" app:strokeColor="#B8D8F2" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@15" android:textColor="#315F83" android:textSize="8sp" />
                    <TextView android:id="@+id/text_product_price15_item" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹0" android:textColor="#0F6CBD" android:textSize="10sp" android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="40dp" android:layout_marginHorizontal="2dp" android:layout_weight="1" app:cardBackgroundColor="#F0F4FF" app:cardCornerRadius="8dp" app:cardElevation="0dp" app:strokeColor="#C5D0F3" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@25" android:textColor="#40548E" android:textSize="8sp" />
                    <TextView android:id="@+id/text_product_price25_item" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹0" android:textColor="#315AC8" android:textSize="10sp" android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="40dp" android:layout_marginHorizontal="2dp" android:layout_weight="1" app:cardBackgroundColor="#F0F9F2" app:cardCornerRadius="8dp" app:cardElevation="0dp" app:strokeColor="#BCDCC3" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@35" android:textColor="#446D4B" android:textSize="8sp" />
                    <TextView android:id="@+id/text_product_price35_item" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹0" android:textColor="#107C10" android:textSize="10sp" android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="40dp" android:layout_marginHorizontal="2dp" android:layout_weight="1" app:cardBackgroundColor="#FFF8E8" app:cardCornerRadius="8dp" app:cardElevation="0dp" app:strokeColor="#E8D29A" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@42" android:textColor="#80631D" android:textSize="8sp" />
                    <TextView android:id="@+id/text_product_price42_item" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹0" android:textColor="#9A6B00" android:textSize="10sp" android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="40dp" android:layout_marginStart="2dp" android:layout_weight="1" app:cardBackgroundColor="#E6F4E9" app:cardCornerRadius="8dp" app:cardElevation="0dp" app:strokeColor="#97CAA2" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@50" android:textColor="#2F6638" android:textSize="8sp" />
                    <TextView android:id="@+id/text_product_price50_item" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹0" android:textColor="#0B6B22" android:textSize="10sp" android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
